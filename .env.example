# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. `.env` is gitignored; never commit a real value.
#   cp .env.example .env
#
# docker compose reads this file for every service. When you run the backend
# outside compose, export the variables first:
#   set -a; . ./.env; set +a
#
# Names follow the properties in
# gms_backend/src/main/resources/application.properties — an entry that binds to
# no property is a bug, not a convenience (see finding SEC-15).
# ─────────────────────────────────────────────────────────────────────────────

# ── Profile ──────────────────────────────────────────────────────────────────
# dev  = local container database, relaxed checks, schema from Hibernate for now
# prod = nothing is defaulted; StartupSecurityValidator fails the boot if a value
#        below is missing, weak, or left at a published default
SPRING_PROFILES_ACTIVE=dev

# ── Database ─────────────────────────────────────────────────────────────────
# DB_URL is the whole JDBC URL; the app has no default for it outside dev.
DB_URL=jdbc:postgresql://localhost:5432/gms
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gms
DB_USERNAME=gms_user
DB_PASSWORD=replace-with-your-local-postgres-password

# Flyway baseline is pending (mandate §9); keep validate outside dev.
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
FLYWAY_ENABLED=true

# ── JWT signing ──────────────────────────────────────────────────────────────
# Generate one: openssl rand -base64 48
# Minimum 32 bytes. Tokens are invalidated when the secret changes, and every
# instance in a fleet must share the same value.
SECURITY_JWT_SECRET=
SECURITY_JWT_VALIDITY_SECONDS=3600
SECURITY_JWT_ISSUER=gms

# ── Login throttling ─────────────────────────────────────────────────────────
# Failed logins accumulate in users.login_attempts; reaching this number sets
# users.account_locked, which CustomUserDetailsService enforces. An administrator
# clears it by resetting the two columns for that account.
SECURITY_LOGIN_MAX_FAILED_ATTEMPTS=10

# ── Platform (SUPERADMIN) account ────────────────────────────────────────────
# Leave disabled unless you are deliberately creating the first account. All five
# values are required together when enabled; there is no default password.
APP_SUPERADMIN_ENABLED=false
APP_SUPERADMIN_USERNAME=
APP_SUPERADMIN_PASSWORD=
APP_SUPERADMIN_EMAIL=
APP_SUPERADMIN_FULL_NAME=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Exact browser origins, comma-separated, no trailing slash.
# In production these must be HTTPS and must not contain localhost.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Mail (optional) ──────────────────────────────────────────────────────────
# Unconfigured mail does not affect startup or health.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── Logging ──────────────────────────────────────────────────────────────────
# INFO in production. DEBUG on com.gms logs request identifiers and is not
# accepted by StartupSecurityValidator outside dev.
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_COM_GMS=INFO
